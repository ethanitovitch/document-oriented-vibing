{
  "name": "document-oriented-vibing",
  "displayName": "document-oriented-vibing",
  "description": "Get the same cursor features in VSCode with Codex",
  "version": "0.0.5",
  "publisher": "ethanitovitch",
  "icon": "assets/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ethanitovitch/document-oriented-vibing.git"
  },
  "homepage": "https://github.com/ethanitovitch/document-oriented-vibing#readme",
  "bugs": {
    "url": "https://github.com/ethanitovitch/document-oriented-vibing/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onUri",
    "onCommand:document-oriented-vibing.copyForLlm",
    "onCommand:document-oriented-vibing.copyForLlmShortcut"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "document-oriented-vibing.home",
        "title": "DOV: Home"
      },
      {
        "command": "document-oriented-vibing.newFeature",
        "title": "DOV: Quick New Feature"
      },
      {
        "command": "document-oriented-vibing.openFeature",
        "title": "DOV: Open Feature"
      },
      {
        "command": "document-oriented-vibing.settings",
        "title": "DOV: Settings"
      },
      {
        "command": "document-oriented-vibing.review",
        "title": "DOV: +review"
      },
      {
        "command": "document-oriented-vibing.captureReview",
        "title": "DOV: Capture Codex Review"
      },
      {
        "command": "document-oriented-vibing.copyForLlm",
        "title": "DOV: Copy Selection for LLM"
      },
      {
        "command": "document-oriented-vibing.newAgent",
        "title": "DOV: New Agent Tab",
        "icon": "$(plus)"
      },
      {
        "command": "document-oriented-vibing.refreshAgents",
        "title": "DOV: Refresh Agents",
        "icon": "$(refresh)"
      },
      {
        "command": "document-oriented-vibing.renameAgent",
        "title": "DOV: Rename Agent",
        "icon": "$(edit)"
      },
      {
        "command": "document-oriented-vibing.openAgent",
        "title": "Codex: Switch Agent"
      },
      {
        "command": "document-oriented-vibing.newSidebarAgent",
        "title": "Codex: New Sidebar Chat",
        "icon": "$(plus)"
      }
    ],
    "keybindings": [
      {
        "command": "document-oriented-vibing.copyForLlmShortcut",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "codexSecondaryViewContainer": [
        {
          "id": "document-oriented-vibing.codexAgents",
          "name": "Agents",
          "when": "!chatgpt.doesNotSupportSecondarySidebar",
          "visibility": "visible"
        }
      ],
      "codexViewContainer": [
        {
          "id": "document-oriented-vibing.codexAgentsLegacy",
          "name": "Agents",
          "when": "chatgpt.doesNotSupportSecondarySidebar",
          "visibility": "visible"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "document-oriented-vibing.renameAgent",
          "when": "viewItem == dovAgent",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "document-oriented-vibing.newSidebarAgent",
          "when": "view == document-oriented-vibing.codexAgents || view == document-oriented-vibing.codexAgentsLegacy",
          "group": "navigation"
        },
        {
          "command": "document-oriented-vibing.refreshAgents",
          "when": "view == document-oriented-vibing.codexAgents || view == document-oriented-vibing.codexAgentsLegacy",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "document-oriented-vibing.openAgent",
          "when": "false"
        },
        {
          "command": "document-oriented-vibing.renameAgent",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "deploy": "scripts/update-extension.sh",
    "update-extension": "scripts/update-extension.sh",
    "publish:marketplace": "scripts/publish-marketplace.sh"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "dompurify": "^3.3.3",
    "mermaid": "^11.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shiki": "^4.0.2"
  },
  "extensionDependencies": [
    "openai.chatgpt"
  ]
}
